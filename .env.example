# --- Web app (apps/web) -----------------------------------------------------
# Operator password for the auth-light gate (D5). Unset = gate open (dev).
APP_PASSWORD=

# --- Worker (apps/worker) ---------------------------------------------------
# Mongo (Railway Mongo plugin provides MONGO_URL; map it to MONGODB_URI)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=blogagent

# Anthropic API key for the Agent SDK phases
ANTHROPIC_API_KEY=

# Queue tuning
WORKER_CONCURRENCY=1
POLL_INTERVAL_MS=3000
LEASE_SECONDS=300
HEARTBEAT_SECONDS=60
MAX_RUN_ATTEMPTS=2
MAX_GATE_ATTEMPTS=2

# Per-phase models (D13). Defaults to claude-sonnet-5 everywhere.
# PHASE_MODEL_DEFAULT=claude-sonnet-5
# PHASE_MODEL_WRITE=claude-opus-5
# PHASE_MODEL_EDIT=claude-opus-5

# Invocation route per phase (roadmap 10.3, D25). Strategist, Writer, Editor,
# Schema Builder and Header Designer default to one direct Messages API call;
# set a phase back to the Agent SDK with PHASE_ROUTE_<PHASE>=agent (rollback
# switch). Research always runs on the Agent SDK (live web tools).
# PHASE_ROUTE_WRITE=agent
# Adaptive-thinking effort for direct calls: low|medium|high|xhigh|max (default high)
# PHASE_EFFORT_EDIT=high
# PHASE_MAX_TOKENS=64000

# --- Topic & Cluster Generator (roadmap 4C, D30/D31) ------------------------
# Model tiers (D26): main reasoning + cheap bulk fan-out
# CLUSTER_MODEL=claude-sonnet-5
# CLUSTER_FANOUT_MODEL=claude-haiku-4-5-20251001
# CLUSTER_FANOUT_K=5
# CLUSTER_MAX_VALIDATIONS=5
# CLUSTER_MAX_ATTEMPTS=2

# Citation verification model (D34) — cheap tier judges claim-vs-page support
# CITATION_MODEL=claude-haiku-4-5-20251001

# --- Content plans + cadence scheduler ---------------------------------------
# Brief enrichment after importing a content plan (cheap tier; falls back to
# CLUSTER_FANOUT_MODEL, then Haiku). ~500 calls for a 500-row plan, run once.
# PLAN_ENRICH_MODEL=claude-haiku-4-5-20251001
# PLAN_ENRICH_CONCURRENCY=6
# PLAN_MAX_ATTEMPTS=2

# The cadence scheduler is OFF unless explicitly enabled — a scheduler that
# starts firing on deploy would spend money nobody asked for. Each plan's
# schedule also starts paused and must be started from the plan board.
# SCHEDULER_ENABLED=0
# SCHEDULE_POLL_INTERVAL_MS=60000
# SCHEDULE_DRY_RUN=0

# --- Competitive module (roadmap Phase 6) ------------------------------------
# Python for blogscraper (defaults: blogscraper/.venv locally, the Docker
# image sets /opt/scraper-venv). Scrape jobs run on the worker's scrape queue.
# SCRAPER_PYTHON=
# SCRAPE_MAX_ATTEMPTS=2
# SCRAPE_TIMEOUT_MS=2700000

# Observed fan-out via Gemini Search grounding (unset = simulated mode)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# DataForSEO — SERP/PAA + AI-surface validation (unset = validation skipped).
# DATAFORSEO_SANDBOX=1 hits the sandbox host (dummy data, no billing).
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# DATAFORSEO_SANDBOX=

# Binary storage (D3): local (default) or s3 (Railway bucket is S3-compatible)
STORAGE_DRIVER=local
# STORAGE_DIR=outputs/storage
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Company config override (defaults to config/company.yaml)
# COMPANY_CONFIG=

# HubSpot token env var — must match hubspot.token_env in company.yaml
# SAPORO_HUBSPOT_TOKEN=
